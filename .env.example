# ── Database ──────────────────────────────────────────────────────────────
# Local dev uses the docker Postgres from `npm run db:start`.
# For Supabase use the pooled connection string (pgbouncer, port 6543):
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# ── Supabase (image storage — optional in dev) ─────────────────────────────
# STORAGE_DRIVER=local writes to static/uploads (dev only, not on Workers).
# STORAGE_DRIVER=supabase uploads product images to a public Storage bucket.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# openssl rand -hex 32
SESSION_SECRET="dev-only-secret-change-me"

# ── Payments ──────────────────────────────────────────────────────────────
# Local hosted-payment gateway (bKash/SSLCommerz-style adapter).
# Leave LOCAL_GATEWAY_URL empty to hide the online-payment option.
LOCAL_GATEWAY_URL=""
# Shared secret for HMAC-SHA256 webhook signature verification.
PAYMENT_WEBHOOK_SECRET=""

# ── Public ────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL="http://localhost:5173"
PUBLIC_SITE_NAME="Flare Store"
PUBLIC_WHATSAPP_NUMBER=""
