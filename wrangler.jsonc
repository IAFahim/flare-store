{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "flare-store",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "df5d0d1f5bb64882b9de3942c5652761"
		}
	],
	"vars": {
		"PUBLIC_SITE_NAME": "Flare Store",
		"PUBLIC_WHATSAPP_NUMBER": "8801863748955",
		"STORAGE_DRIVER": "local"
	},
	"workers_dev": true,
	"preview_urls": true
}
